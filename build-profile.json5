{
  "app": {
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "targetSdkVersion": "5.0.4(16)",
        "compatibleSdkVersion": "5.0.4(16)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug",
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "default",
      "srcPath": "./products/default",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    },
    {
      "name": "e01_hello_world",
      "srcPath": "./features/e01_hello_world",
    },
    {
      "name": "utils",
      "srcPath": "./commons/utils",
    },
    {
      "name": "ui_components",
      "srcPath": "./commons/ui_components",
    },
    {
      "name": "e02_hmrouter",
      "srcPath": "./features/e02_hmrouter",
    },
    {
      "name": "models",
      "srcPath": "./commons/models",
    },
    {
      "name": "e03_debug_log",
      "srcPath": "./features/e03_debug_log",
    },
    {
      "name": "hilogx",
      "srcPath": "./ohpm_dev/hilogx",
    },
    {
      "name": "e99_playground",
      "srcPath": "./features/e99_playground",
    },
    {
      "name": "e04_async",
      "srcPath": "./features/e04_async",
    }
  ]
}